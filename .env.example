# Required: Prisma connection string for the source SQL Server database.
# Create a database with the schema in `prisma/schema.prisma` and seed the
# `ethniclist` table with your starting taxonomy of groups.
#
# Format for SQL Server:
DATABASE_URL="sqlserver://HOST:1433;database=DBNAME;user=USERNAME;password=PASSWORD;encrypt=true;trustServerCertificate=true"

# Required for analyze-images-via-bedrock.mjs:
AWS_REGION=us-east-1

# AWS credentials. The script uses fromIni() by default, so credentials in
# `~/.aws/credentials` under the [default] profile will be picked up
# automatically. Override here only if you use a non-default profile or
# want to pin them via env vars instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default

# Optional: defaults baked into the analyze script. Override on the command
# line via flags rather than env if you only need a one-off change.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
